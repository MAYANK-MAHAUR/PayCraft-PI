# =====================================================================
# PayCraft Environment Configuration Example
# Copy to .env or configure in Zerops dashboard
# =====================================================================

# ---------------------------------------------------------------------
# API Service (Node.js Express - Port 3000)
# ---------------------------------------------------------------------
PORT=3000
NODE_ENV=production
JWT_SECRET=paycraft_super_secret_jwt_key_2026

# Database & Cache (Injected automatically by Zerops or local Postgres/Valkey)
DATABASE_URL=postgresql://user:password@localhost:5432/paycraft
REDIS_URL=redis://localhost:6379

# Google OAuth 2.0 Client ID (Required for Google Sign-In)
GOOGLE_CLIENT_ID=282697891216-fvla018lcu7mjrbv8nvvjehkc7j7r1oi.apps.googleusercontent.com

# ---------------------------------------------------------------------
# Frontend Service (React + Vite SPA)
# ---------------------------------------------------------------------
VITE_API_URL=https://api-2ba1-3000.prg1.zerops.app/api
VITE_GOOGLE_CLIENT_ID=282697891216-fvla018lcu7mjrbv8nvvjehkc7j7r1oi.apps.googleusercontent.com

# ---------------------------------------------------------------------
# Object Storage (S3 / Zerops Storage)
# ---------------------------------------------------------------------
STORAGE_API_URL=http://storage:8080
STORAGE_ACCESS_KEY_ID=your_access_key
STORAGE_SECRET_ACCESS_KEY=your_secret_key
STORAGE_BUCKET_NAME=paycraft-files
